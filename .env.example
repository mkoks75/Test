# Kopieer naar .env op de Hetzner-server (niet in git).

# PostgreSQL-container
POSTGRES_USER=voorraad
POSTGRES_PASSWORD=verander-dit-in-iets-langs
POSTGRES_DB=voorraad

# Poort waarop de app naar buiten luistert op de server
APP_PORT=8000

# Sleutel waarmee de sessiecookie versleuteld wordt: minimaal 32 tekens.
# Genereer met: openssl rand -base64 48
SESSION_SECRET=

# Publieke url van de applicatie, gebruikt in e-mails en deellinks
APP_URL=https://voorraad.example.nl

# E-mail voor wachtwoord-reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=voorraad@example.nl
